{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'set -o pipefail; make check 2>&1 | tail -80'",
            "timeout": 180,
            "statusMessage": "make check"
          }
        ]
      }
    ]
  }
}
